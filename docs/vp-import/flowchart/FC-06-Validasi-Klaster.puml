' Flowchart FC-06 — Validasi Hasil Klaster (uji stabilitas, uji beda
' antar-klaster, dan validasi pakar).
' Notasi flowchart baku ISO 5807:1985 (terminal = OVAL, proses = persegi,
' keputusan = belah ketupat, input/output = jajar genjang).
' Render: tools/render-flowchart.ps1 (PlantUML @startdot -> SVG -> PNG).
'
' Catatan: uji stabilitas (bootstrap-Jaccard) dan uji beda antar-klaster
' (Kruskal-Wallis) bersifat PELENGKAP — bukan pengganti evaluasi internal
' (Silhouette, Davies-Bouldin, Elbow) yang tetap menjadi metrik utama
' karena K-Means bersifat unsupervised.
' Kruskal-Wallis dipilih (non-parametrik) sehingga tidak bergantung pada
' asumsi normalitas maupun homogenitas ragam.
@startdot
digraph FC06 {
  rankdir=TB; bgcolor="white";
  graph [nodesep=0.4, ranksep=0.42];
  node [fontname="Segoe UI", fontsize=11, color="#333333", style=filled, fillcolor="white", margin="0.14,0.07"];
  edge [fontname="Segoe UI", fontsize=10, color="#333333"];

  mulai   [shape=ellipse, fillcolor="#ECECEC", label="Mulai"];
  input   [shape=parallelogram, label="Input: klaster final terbentuk\n(K-Means; k dipilih via Elbow;\nkualitas via Silhouette & DBI)"];
  stabil  [shape=box, label="Uji stabilitas klaster\n(bootstrap-Jaccard)"];
  beda    [shape=box, label="Uji beda antar-klaster\n(Kruskal-Wallis, non-parametrik)"];
  pakar   [shape=box, label="Validasi pakar\n(Wakil Dekan III)"];
  output  [shape=parallelogram, label="Output: skor stabilitas, hasil uji beda antar-klaster,\ndan catatan validasi pakar"];
  selesai [shape=ellipse, fillcolor="#ECECEC", label="Selesai"];

  mulai -> input;
  input -> stabil [label="stabil?"];
  stabil -> beda  [label="beda nyata?"];
  beda -> pakar;
  pakar -> output -> selesai;
}
@enddot
