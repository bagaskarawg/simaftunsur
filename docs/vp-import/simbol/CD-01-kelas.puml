' Simbol Class — Kelas (nama, atribut, operasi + visibilitas). UML 2.5.1.
@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide circle
class NamaKelas {
  + atributPublik
  - atributPrivat
  # atributTerlindungi
  + operasi()
}
@enduml
