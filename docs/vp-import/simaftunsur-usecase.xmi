<?xml version="1.0" encoding="UTF-8"?>
<!--
  SIMAFTUNSUR — Model Use Case (UML 2.1 / XMI 2.1)
  Cara pakai di Visual Paradigm: Project > Import > XMI... lalu pilih file ini.
  Elemen masuk ke Model Explorer; buat Use Case Diagram baru dan seret
  aktor/use case ke kanvas (relasi tergambar otomatis).

  LIMA AKTOR (kesepakatan bimbingan 2 Juli 2026):
    - Administrator      : manajemen sistem, pengguna & hak akses, konfigurasi.
    - Wakil Dekan III    : konsumen utama — dashboard klasterisasi, profil
                           mahasiswa, laporan kemahasiswaan (read-only).
    - Staf WD III        : kelola data mahasiswa & IPK; menjalankan klasterisasi.
    - Ketua Program Studi: monitoring IPK mahasiswa & penerima beasiswa (read-only).
    - Staf Prodi         : update prestasi akademik/non-akademik; kelola kegiatan.

  Diturunkan dari: routes/web.php + config/peran.php (2026-07-02).
  Catatan:
  - Use case "extend" tidak diberi asosiasi aktor langsung — aksesnya
    mengikuti use case dasar yang diperluas.
  - Use case kelola untuk Tracer, Promosi/PMB, Beasiswa, KKN, dan
    Pengabdian saat ini hanya terhubung ke Administrator (wildcard),
    karena belum ada peran fungsional yang ditetapkan mengelolanya.
-->
<xmi:XMI xmi:version="2.1"
         xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <uml:Model xmi:id="model_simaftunsur_uc" name="SIMAFTUNSUR — Use Case">

    <!-- ======================= AKTOR (5) ======================= -->
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_admin" name="Administrator"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_wd3" name="Wakil Dekan III"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_stafwd3" name="Staf WD III"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_kaprodi" name="Ketua Program Studi"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_stafprodi" name="Staf Prodi"/>

    <!-- ======================= USE CASE — AUTENTIKASI ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_masuk" name="Masuk (Login)"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_reset" name="Mereset Kata Sandi">
      <extend xmi:id="ext_reset" extendedCase="uc_masuk"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_keluar" name="Keluar (Logout)"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_beranda" name="Melihat Beranda"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_profil" name="Mengelola Profil Akun"/>

    <!-- ======================= USE CASE — DATA MAHASISWA ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_mhs_lihat" name="Melihat Data Mahasiswa"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_mhs_kelola" name="Mengelola Data Mahasiswa"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_mhs_impor" name="Mengimpor Data Mahasiswa (Excel)">
      <extend xmi:id="ext_mhs_impor" extendedCase="uc_mhs_kelola"/>
      <include xmi:id="inc_mhs_tpl" addition="uc_template"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ipk_kelola" name="Mengelola Nilai IPK per Semester"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ipk_impor" name="Mengimpor IPK Massal (Excel)">
      <extend xmi:id="ext_ipk_impor" extendedCase="uc_ipk_kelola"/>
      <include xmi:id="inc_ipk_tpl" addition="uc_template"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_template" name="Mengunduh Template Impor"/>

    <!-- ======================= USE CASE — KLASTERISASI K-MEANS ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_klaster_lihat" name="Melihat Hasil Klasterisasi"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_klaster_detail" name="Melihat Detail Klaster">
      <extend xmi:id="ext_klaster_detail" extendedCase="uc_klaster_lihat"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_klaster_jalan" name="Menjalankan Klasterisasi K-Means"/>

    <!-- ======================= USE CASE — MODUL PENDUKUNG (CRUD) ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_prestasi_lihat" name="Melihat Data Prestasi"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_prestasi_kelola" name="Mengelola Data Prestasi"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_kegiatan_lihat" name="Melihat Kegiatan &amp; Organisasi"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_kegiatan_kelola" name="Mengelola Kegiatan &amp; Organisasi"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_pengabdian_lihat" name="Melihat Pengabdian &amp; Hibah"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_pengabdian_kelola" name="Mengelola Pengabdian &amp; Hibah"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_beasiswa_lihat" name="Melihat Data Beasiswa"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_beasiswa_kelola" name="Mengelola Data Beasiswa"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_kkn_lihat" name="Melihat Data KKN"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_kkn_kelola" name="Mengelola Data KKN"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_tracer_lihat" name="Melihat Tracer Study"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_tracer_kelola" name="Mengelola Tracer Study"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_promosi_lihat" name="Melihat Kegiatan Promosi/PMB"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_promosi_kelola" name="Mengelola Kegiatan Promosi/PMB"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_sekolah" name="Mengelola Sekolah Target">
      <extend xmi:id="ext_sekolah" extendedCase="uc_promosi_kelola"/>
    </packagedElement>

    <!-- ======================= USE CASE — LAPORAN ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_laporan_lihat" name="Melihat Laporan Kemahasiswaan"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_laporan_ekspor" name="Mengekspor Laporan (CSV/PDF)">
      <extend xmi:id="ext_laporan_ekspor" extendedCase="uc_laporan_lihat"/>
    </packagedElement>

    <!-- ======================= USE CASE — ADMINISTRASI SISTEM ======================= -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_pengguna" name="Mengelola Pengguna &amp; Peran"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_pengaturan" name="Mengelola Pengaturan Sistem"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_backup" name="Mengunduh Backup Data (JSON)">
      <extend xmi:id="ext_backup" extendedCase="uc_pengaturan"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_log" name="Melihat Log Aktivitas"/>

    <!-- ======================= ASOSIASI AUTENTIKASI (semua aktor) ======================= -->
