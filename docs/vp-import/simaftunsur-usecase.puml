' =====================================================================
' SIMAFTUNSUR — Use Case Diagram (PlantUML)
' Notasi mengikuti OMG Unified Modeling Language (UML) v2.5.1
' (Object Management Group, 2017); konsisten dengan Pressman & Maxim (2020).
' Sesuai spesifikasi, AKTOR eksternal terhadap subjek → digambar DI LUAR
' system boundary; use case DI DALAM boundary.
' 6 aktor (kesepakatan bimbingan 2 Jul 2026 + Wakil Rektor III, masukan 27 Jul 2026).
' Render gratis: planttext.com / plantuml.com/plantuml / VS Code (ekstensi PlantUML).
' =====================================================================

@startuml UC-SIMAFTUNSUR
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam packageStyle rectangle
left to right direction

' Aktor umum "Pengguna" digeneralisasi oleh 6 peran (mengurangi garis asosiasi
' untuk use case bersama; generalisasi aktor = notasi UML baku).
actor "Pengguna" as user
actor "Administrator" as admin
actor "Staf WD III" as stafwd3
actor "Staf Prodi" as stafprodi
actor "Wakil Dekan III" as wd3
actor "Ketua Program Studi" as kaprodi
actor "Wakil Rektor III" as wr3

admin    --|> user
stafwd3  --|> user
stafprodi --|> user
wd3      --|> user
kaprodi  --|> user
wr3      --|> user

rectangle SIMAFTUNSUR {
  package "Autentikasi & Akun" {
    usecase "Masuk (Login)" as ucMasuk
    usecase "Mereset Kata Sandi" as ucReset
    usecase "Keluar (Logout)" as ucKeluar
    usecase "Melihat Beranda" as ucBeranda
    usecase "Mengelola Profil Akun" as ucProfil
  }
  package "Data Mahasiswa" {
    usecase "Melihat Data Mahasiswa" as ucMhsLihat
    usecase "Mengelola Data Mahasiswa" as ucMhsKelola
    usecase "Mengimpor Data Mahasiswa (Excel)" as ucMhsImpor
    usecase "Mengelola Nilai IPK per Semester" as ucIpk
    usecase "Mengimpor IPK Massal (Excel)" as ucIpkImpor
  }
  package "Klasterisasi K-Means" {
    usecase "Menjalankan Klasterisasi K-Means" as ucKlasterJalan
    usecase "Melihat Hasil Klasterisasi" as ucKlasterLihat
    usecase "Melihat Detail Klaster" as ucKlasterDetail
  }
  package "Penilaian Non-Akademik (SKKM)" {
    usecase "Mengelola Prestasi" as ucPrestasi
    usecase "Mengelola Kegiatan & Organisasi" as ucKegiatan
    usecase "Mengelola Pengabdian & Hibah" as ucPengabdian
  }
  package "Penyaringan & Laporan" {
    usecase "Menyaring Kandidat Program (Beasiswa / Mawapres)" as ucSaring
    usecase "Mengelola Program & Syarat" as ucProgram
    usecase "Melihat Laporan Kemahasiswaan" as ucLaporanL
    usecase "Mengekspor Laporan (CSV/PDF)" as ucLaporanE
  }
  package "Modul Pendukung (CRUD)" {
    usecase "Mengelola Beasiswa" as ucBeasiswa
    usecase "Mengelola KKN" as ucKkn
    usecase "Mengelola Tracer Study" as ucTracer
    usecase "Mengelola Promosi / PMB" as ucPromosi
  }
  package "Administrasi Sistem" {
    usecase "Mengelola Pengguna & Peran (RBAC)" as ucPengguna
    usecase "Mengelola Pengaturan Sistem" as ucPengaturan
    usecase "Melihat Log Aktivitas" as ucLog
  }
}

' --- Use case bersama via aktor umum (hemat garis) ---
user -- ucMasuk
user -- ucKeluar
user -- ucBeranda
user -- ucProfil

' --- Relasi extend / include ---
ucReset ..> ucMasuk : <<extend>>
ucMhsImpor ..> ucMhsKelola : <<extend>>
ucIpkImpor ..> ucIpk : <<extend>>
ucKlasterDetail ..> ucKlasterLihat : <<extend>>
ucLaporanE ..> ucLaporanL : <<extend>>
ucSaring ..> ucKlasterLihat : <<include>>

' --- Staf WD III: data mahasiswa/IPK + jalankan klasterisasi + penyaringan ---
stafwd3 -- ucMhsKelola
stafwd3 -- ucMhsImpor
stafwd3 -- ucIpk
stafwd3 -- ucKlasterJalan
stafwd3 -- ucKlasterLihat
stafwd3 -- ucSaring

' --- Staf Prodi: penilaian non-akademik ---
stafprodi -- ucMhsLihat
stafprodi -- ucPrestasi
stafprodi -- ucKegiatan
stafprodi -- ucPengabdian

' --- Kaprodi: monitoring (read-only) ---
kaprodi -- ucMhsLihat

' --- Wakil Dekan III: konsumen hasil + penyaringan + laporan ---
wd3 -- ucKlasterLihat
wd3 -- ucSaring
wd3 -- ucProgram
wd3 -- ucLaporanL
wd3 -- ucLaporanE

' --- Wakil Rektor III: laporan tingkat universitas ---
wr3 -- ucLaporanL
wr3 -- ucLaporanE

' --- Administrator: seluruh modul (wildcard) ---
admin -- ucMhsKelola
admin -- ucKlasterJalan
admin -- ucPrestasi
admin -- ucKegiatan
admin -- ucPengabdian
admin -- ucSaring
admin -- ucProgram
admin -- ucBeasiswa
admin -- ucKkn
admin -- ucTracer
admin -- ucPromosi
admin -- ucPengguna
admin -- ucPengaturan
admin -- ucLog
@enduml

' Versi ringkas khusus modul fokus penelitian — lebih mudah dibaca di naskah.
@startuml UC-Klasterisasi
skinparam backgroundColor #FFFFFF
left to right direction
skinparam actorStyle awesome

actor "Wakil Dekan III" as wd3
actor "Staf WD III" as stafwd3
actor "Administrator" as admin

rectangle "SIMAFTUNSUR — Modul Klasterisasi & Data Mahasiswa" {
  usecase "Melihat Data Mahasiswa" as ucMhsLihat
  usecase "Mengelola Data Mahasiswa" as ucMhsKelola
  usecase "Mengimpor Data Mahasiswa (Excel)" as ucMhsImpor
  usecase "Mengelola Nilai IPK per Semester" as ucIpk
  usecase "Mengimpor IPK Massal (Excel)" as ucIpkImpor
  usecase "Menjalankan Klasterisasi K-Means" as ucKlasterJalan
  usecase "Melihat Hasil Klasterisasi" as ucKlasterLihat
  usecase "Melihat Detail Klaster" as ucKlasterDetail
}

ucMhsImpor ..> ucMhsKelola : <<extend>>
ucIpkImpor ..> ucIpk : <<extend>>
ucKlasterDetail ..> ucKlasterLihat : <<extend>>

stafwd3 -- ucMhsLihat
stafwd3 -- ucMhsKelola
stafwd3 -- ucIpk
stafwd3 -- ucKlasterJalan
stafwd3 -- ucKlasterLihat
wd3 -- ucMhsLihat
wd3 -- ucKlasterLihat
admin -- ucMhsKelola
admin -- ucKlasterJalan
admin -- ucKlasterLihat
@enduml
