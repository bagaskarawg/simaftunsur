<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Defs_ProsesBerjalan" targetNamespace="http://simaftunsur/bpmn">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="pool_proses" name="Pengelolaan Data Kemahasiswaan (Sistem Berjalan)" processRef="proc_berjalan" />
  </bpmn:collaboration>
  <bpmn:process id="proc_berjalan" isExecutable="false">
    <bpmn:laneSet id="ls_1">
      <bpmn:lane id="lane_wd3" name="Wakil Dekan III">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_staf" name="Staf Kemahasiswaan">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_unit" name="Unit / Program Studi">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="s1" name="Perlu gambaran
karakteristik mahasiswa">
      <bpmn:outgoing>f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="t1" name="Ajukan permintaan
rekapitulasi data">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t2" name="Kumpulkan data dari
berkas tiap unit">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t3" name="Sediakan berkas data
(lembar kerja terpisah)">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t4" name="Rekapitulasi data
secara manual">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t5" name="Susun profil mahasiswa
berdasarkan asumsi">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t6" name="Serahkan rekap
ke pimpinan">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t7" name="Tinjau rekapitulasi">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="g1" name="Data
memadai?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="t8" name="Rumuskan strategi
pembinaan">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="e1" name="Strategi pembinaan
ditetapkan">
      <bpmn:incoming>f11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
      <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
      <bpmn:sequenceFlow id="f3" name="minta berkas" sourceRef="t2" targetRef="t3" />
      <bpmn:sequenceFlow id="f4" name="berkas" sourceRef="t3" targetRef="t4" />
      <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="t5" />
      <bpmn:sequenceFlow id="f6" sourceRef="t5" targetRef="t6" />
      <bpmn:sequenceFlow id="f7" sourceRef="t6" targetRef="t7" />
      <bpmn:sequenceFlow id="f8" sourceRef="t7" targetRef="g1" />
      <bpmn:sequenceFlow id="f9" name="Ya" sourceRef="g1" targetRef="t8" />
      <bpmn:sequenceFlow id="f10" name="Tidak (lengkapi data)" sourceRef="g1" targetRef="t2" />
      <bpmn:sequenceFlow id="f11" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="collab_1">
      <bpmndi:BPMNShape id="di_pool" bpmnElement="pool_proses" isHorizontal="true"><dc:Bounds x="40" y="20" width="1620" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_lane_wd3" bpmnElement="lane_wd3" isHorizontal="true"><dc:Bounds x="160" y="25" width="1500" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_lane_staf" bpmnElement="lane_staf" isHorizontal="true"><dc:Bounds x="160" y="225" width="1500" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_lane_unit" bpmnElement="lane_unit" isHorizontal="true"><dc:Bounds x="160" y="425" width="1500" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s1" bpmnElement="s1"><dc:Bounds x="240" y="95" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t1" bpmnElement="t1"><dc:Bounds x="330" y="95" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t2" bpmnElement="t2"><dc:Bounds x="530" y="295" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t3" bpmnElement="t3"><dc:Bounds x="530" y="495" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t4" bpmnElement="t4"><dc:Bounds x="720" y="295" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t5" bpmnElement="t5"><dc:Bounds x="910" y="295" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t6" bpmnElement="t6"><dc:Bounds x="1100" y="295" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t7" bpmnElement="t7"><dc:Bounds x="1100" y="95" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_g1" bpmnElement="g1"><dc:Bounds x="1300" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t8" bpmnElement="t8"><dc:Bounds x="1390" y="95" width="150" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_e1" bpmnElement="e1"><dc:Bounds x="1580" y="95" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1"><di:waypoint x="258" y="113" /><di:waypoint x="405" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2"><di:waypoint x="405" y="130" /><di:waypoint x="605" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f3" bpmnElement="f3"><di:waypoint x="605" y="330" /><di:waypoint x="605" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f4" bpmnElement="f4"><di:waypoint x="605" y="530" /><di:waypoint x="795" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f5" bpmnElement="f5"><di:waypoint x="795" y="330" /><di:waypoint x="985" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f6" bpmnElement="f6"><di:waypoint x="985" y="330" /><di:waypoint x="1175" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f7" bpmnElement="f7"><di:waypoint x="1175" y="330" /><di:waypoint x="1175" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f8" bpmnElement="f8"><di:waypoint x="1175" y="130" /><di:waypoint x="1325" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f9" bpmnElement="f9"><di:waypoint x="1325" y="120" /><di:waypoint x="1465" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f10" bpmnElement="f10"><di:waypoint x="1325" y="120" /><di:waypoint x="605" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f11" bpmnElement="f11"><di:waypoint x="1465" y="130" /><di:waypoint x="1598" y="113" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
