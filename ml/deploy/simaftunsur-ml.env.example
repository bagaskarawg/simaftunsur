# EnvironmentFile untuk service klasterisasi (dibaca systemd).
# Salin ke: /home/forge/k-means-service.bahas.tech/shared/ml.env
#   nano /home/forge/k-means-service.bahas.tech/shared/ml.env   # isi kunci
#   chmod 600 /home/forge/k-means-service.bahas.tech/shared/ml.env
#
# Berada di shared/ agar PERSISTEN lintas rilis (tidak ikut terhapus deploy).
# Kunci ini HARUS identik dengan ML_API_KEY di .env Laravel (cPanel).
# Buat kunci acak, mis.: openssl rand -hex 32
ML_API_KEY=ganti_dengan_kunci_acak_yang_sama_dengan_laravel
