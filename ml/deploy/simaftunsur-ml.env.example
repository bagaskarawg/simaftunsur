# Contoh EnvironmentFile untuk service klasterisasi.
# Salin ke /etc/simaftunsur-ml.env di VPS, isi kunci asli, lalu:
#   sudo chown root:simaftunsur /etc/simaftunsur-ml.env
#   sudo chmod 640 /etc/simaftunsur-ml.env
#
# Kunci ini HARUS identik dengan ML_API_KEY di .env Laravel (cPanel).
# Buat kunci acak, mis.: openssl rand -hex 32
ML_API_KEY=ganti_dengan_kunci_acak_yang_sama_dengan_laravel
