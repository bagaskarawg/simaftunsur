# Unit systemd untuk service klasterisasi K-Means SIMAFTUNSUR (Laravel Forge).
# Salin ke: /etc/systemd/system/simaftunsur-ml.service
# Lalu   : sudo systemctl daemon-reload && sudo systemctl enable --now simaftunsur-ml
#
# Struktur Forge zero-downtime:
#   /home/forge/k-means-service.bahas.tech/
#   ├── current -> releases/<x>     (WorkingDirectory; berganti tiap deploy)
#   ├── releases/
#   └── shared/                     (persisten lintas rilis)
#       ├── ml-venv/                (virtualenv Python — TIDAK ikut terhapus)
#       └── ml.env                  (ML_API_KEY)
#
# uvicorn hanya dengar di 127.0.0.1:8001; akses publik + TLS ditangani nginx
# (dikelola Forge). Service di-restart otomatis oleh deploy script Forge.

[Unit]
Description=SIMAFTUNSUR - Service Klasterisasi K-Means (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=forge
Group=forge
WorkingDirectory=/home/forge/k-means-service.bahas.tech/current/ml
EnvironmentFile=/home/forge/k-means-service.bahas.tech/shared/ml.env
ExecStart=/home/forge/k-means-service.bahas.tech/shared/ml-venv/bin/uvicorn api:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=3

# Pengerasan dasar (ProtectHome TIDAK dipakai karena app berada di /home/forge)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
